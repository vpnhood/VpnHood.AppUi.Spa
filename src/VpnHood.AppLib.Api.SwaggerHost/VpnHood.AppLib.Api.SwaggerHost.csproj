<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<Description>Poses the app API to NSwag so it can emit the OpenAPI document and the TypeScript client. Never published, never run in an app: every action throws.</Description>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace>VpnHood.AppLib.Api.SwaggerHost</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!--Keep in sync with NSwag.ConsoleCore in ./.config/dotnet-tools.json-->
		<PackageReference Include="NSwag.AspNetCore" Version="[14.7.1]" />
		<!-- The contract this host poses, from NuGet: nothing here references the main repo's source. -->
		<PackageReference Include="VpnHood.AppLib.Api" Version="$(VhPackageVersion)" />
	</ItemGroup>

</Project>
