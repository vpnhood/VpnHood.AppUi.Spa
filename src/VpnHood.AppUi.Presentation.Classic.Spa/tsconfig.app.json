{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "./typed-router.d.ts" //Generated by vue-router's file-based routing
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "Bundler", //For vue-router's file-based routing
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // No baseUrl: it is deprecated in TS 6 and removed in 7. These paths are already relative,
    // so they resolve against this file's folder and the "@/" alias behaves identically.
    "paths": {
      "@/*": ["./src/*"],
    },
  }
}
