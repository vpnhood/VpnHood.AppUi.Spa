<Project>
	<!-- What a head that shows the SPA needs placed beside it, built from the SPA's own dist:

	       assets/ui.zip        the store - images, flags, fonts, content, locales, themes - in the
	                            layout VpnHood.AppUi.Assets.Classic ships. Built HERE, from the SPA's
	                            own dist, and deliberately not taken from that package: the files are
	                            authored next door, so a sample that consumed the published ones would
	                            show a store one publish behind whatever it was just edited to show.
	                            A head outside this repo can reference the package instead; a sample
	                            whose whole subject is these files should not.
	       assets/web-root.zip  the page: index.html and the hashed bundle - everything in dist but
	                            the store, which the app's web host serves at /assets/ out of the
	                            zip above.

	     The app reads both at those asset paths through its platform's IAssetProvider, the way
	     every head of the main repo does; the placement below is the one their packages' targets
	     use. The two lists (locales, fonts) exist because a provider answers by name and never
	     enumerates - they are what _sync-assets.ps1 writes in the main repo. -->
	<PropertyGroup>
		<SpaDir>$(MSBuildThisFileDirectory)VpnHood.AppUi.Presentation.Classic.Spa\</SpaDir>
		<SpaDistDir>$(SpaDir)dist\</SpaDistDir>
		<!-- one folder per target framework: a head of two (the MAUI sample) builds both at once -->
		<SpaZipDir>$(MSBuildProjectDirectory)\obj\spa\$(TargetFramework)\</SpaZipDir>
		<SpaStoreDir>$(SpaZipDir)store\</SpaStoreDir>
		<SpaWebRootDir>$(SpaZipDir)web-root\</SpaWebRootDir>
		<SpaUiZip>$(SpaZipDir)ui.zip</SpaUiZip>
		<SpaWebRootZip>$(SpaZipDir)web-root.zip</SpaWebRootZip>
		<SpaIsAndroidApp>$(TargetFramework.Contains('-android'))</SpaIsAndroidApp>
		<SpaIsIosApp>$(TargetFramework.Contains('-ios'))</SpaIsIosApp>
	</PropertyGroup>

	<!-- Android: one entry in the package's assets, which is not split by CPU architecture. The link
	     starts with the project's own assets folder, which .NET for Android takes as the package's
	     asset root and drops - Assets\ in an Android project, Platforms\Android\Assets\ in a MAUI
	     one - and the file keeps its folder under that root. -->
	<ItemGroup Condition="'$(SpaIsAndroidApp)' == 'true'">
		<AndroidAsset Include="$(SpaUiZip)" Link="$(MonoAndroidAssetsPrefix)\assets\ui.zip" Visible="false" />
		<AndroidAsset Include="$(SpaWebRootZip)" Link="$(MonoAndroidAssetsPrefix)\assets\web-root.zip" Visible="false" />
	</ItemGroup>

	<!-- iOS: a file of the app bundle, read in place. The SDK gathers the bundle's files before
	     BeforeBuild, so the zips are made from its own hook for that. -->
	<PropertyGroup Condition="'$(SpaIsIosApp)' == 'true'">
		<CollectBundleResourcesDependsOn>$(CollectBundleResourcesDependsOn);VhBuildSpaZips</CollectBundleResourcesDependsOn>
	</PropertyGroup>
	<ItemGroup Condition="'$(SpaIsIosApp)' == 'true'">
		<BundleResource Include="$(SpaUiZip)" Link="assets\ui.zip" Visible="false" />
		<BundleResource Include="$(SpaWebRootZip)" Link="assets\web-root.zip" Visible="false" />
	</ItemGroup>

	<!-- Windows: a file beside the executable, read in place. -->
	<ItemGroup Condition="'$(SpaIsAndroidApp)' != 'true' And '$(SpaIsIosApp)' != 'true'">
		<None Include="$(SpaUiZip)" Link="assets\ui.zip" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="$(SpaWebRootZip)" Link="assets\web-root.zip" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<Target Name="VhBuildSpaZips" BeforeTargets="BeforeBuild">
		<Error Condition="!Exists('$(SpaDistDir)index.html')"
		       Text="The SPA is not built. Run 'npm run build' in $(SpaDir)" />

		<ItemGroup>
			<!-- not the film: an internal ad exactly one head plays, which carries it as its own asset -->
			<_SpaStoreFile Include="$(SpaDistDir)assets\**" Exclude="$(SpaDistDir)assets\images\internal-ad.mp4" />
			<_SpaThemeFile Include="$(SpaDistDir)themes\**" />
			<_SpaLocaleFile Include="$(SpaDistDir)assets\locales\*.json" />
			<_SpaFontFile Include="$(SpaDistDir)assets\fonts\*.ttf" />
			<_SpaWebRootFile Include="$(SpaDistDir)**" Exclude="$(SpaDistDir)assets\**" />
		</ItemGroup>
		<PropertyGroup>
			<_SpaLocaleList>@(_SpaLocaleFile->'&quot;%(Filename)&quot;', ',')</_SpaLocaleList>
			<_SpaFontList>@(_SpaFontFile->'&quot;%(Filename)%(Extension)&quot;', ',')</_SpaFontList>
		</PropertyGroup>

		<RemoveDir Directories="$(SpaStoreDir);$(SpaWebRootDir)" />
		<Copy SourceFiles="@(_SpaStoreFile)" DestinationFiles="@(_SpaStoreFile->'$(SpaStoreDir)%(RecursiveDir)%(Filename)%(Extension)')" />
		<Copy SourceFiles="@(_SpaThemeFile)" DestinationFiles="@(_SpaThemeFile->'$(SpaStoreDir)themes\%(RecursiveDir)%(Filename)%(Extension)')" />
		<WriteLinesToFile File="$(SpaStoreDir)locales\index.json" Lines="[$(_SpaLocaleList)]" Overwrite="true" />
		<WriteLinesToFile File="$(SpaStoreDir)fonts\index.json" Lines="[$(_SpaFontList)]" Overwrite="true" />
		<Copy SourceFiles="@(_SpaWebRootFile)" DestinationFiles="@(_SpaWebRootFile->'$(SpaWebRootDir)%(RecursiveDir)%(Filename)%(Extension)')" />

		<Delete Files="$(SpaUiZip);$(SpaWebRootZip)" />
		<ZipDirectory SourceDirectory="$(SpaStoreDir)" DestinationFile="$(SpaUiZip)" />
		<ZipDirectory SourceDirectory="$(SpaWebRootDir)" DestinationFile="$(SpaWebRootZip)" />
	</Target>
</Project>
