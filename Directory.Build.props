<Project>
	<!-- The one version of the VpnHood packages every project here consumes. Nothing in this repo
	     references the main repo's source: the Swagger host and the samples build against the
	     published packages, so what they get is exactly what a head outside that repo gets. The
	     IP-location database follows its own repo's version line. -->
	<PropertyGroup>
		<VhPackageVersion>8.2.854-local5</VhPackageVersion>
		<VhIpLocationsPackageVersion>8.2.859</VhIpLocationsPackageVersion>
	</PropertyGroup>

	<!-- Packages of a VpnHood not yet released, to build against before they are: a .packages folder
	     beside this file, which git ignores, joins the package sources when it exists. -->
	<PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory).packages')">
		<RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory).packages</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- NOTHING HERE IS EVER PUBLISHED. This repo is a sample: it consumes the VpnHood packages and
	     produces none. The SPA bundle used to ship as VpnHood.AppLib.Assets.ClassicSpa; that package is
	     retired, no head reads it, and the samples take the SPA from the folder beside them
	     (src/SpaAssets.targets). So: no IsPackable=true on a project here, no PackageId, and no workflow
	     running `dotnet pack` or `nuget push`. The libraries are published from the main repo
	     (pub/lib/Publish-NugetPackages.ps1), which packs every project under its src/ that has not
	     opted out - this line is that opt-out for everything in this tree. -->
	<PropertyGroup>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
</Project>
